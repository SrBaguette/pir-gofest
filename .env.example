# Twilio — obtener en https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Número WhatsApp de Twilio (sandbox o aprobado)
# Sandbox de prueba: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# URL pública del backend (ngrok, Cloud Run, etc.)
# Ejemplo local: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=https://tu-dominio-publico.com
